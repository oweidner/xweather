#!/bin/sh
# Minimal configure script for xweather.
# Checks for a working C compiler and the Motif (Xm) / X Toolkit (Xt) / X11
# development libraries, then generates Makefile from Makefile.in.

set -e

PREFIX=/usr/local
CC=${CC:-cc}
OS=$(uname -s)

for arg in "$@"; do
    case "$arg" in
        --prefix=*)
            PREFIX="${arg#--prefix=}"
            ;;
        --help)
            echo "Usage: ./configure [--prefix=PATH]"
            echo "  --prefix=PATH   installation prefix (default: /usr/local)"
            exit 0
            ;;
        *)
            echo "configure: unknown option '$arg'" >&2
            exit 1
            ;;
    esac
done

TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

log() { printf '%s\n' "$*" >> config.log; }
info() { printf 'checking %s... ' "$1"; }
ok() { printf 'yes\n'; log "$1: yes"; }
no() { printf 'no\n'; log "$1: no"; }

: > config.log

info "for $CC"
if ! command -v "$CC" >/dev/null 2>&1; then
    no
    echo "configure: error: no C compiler found (tried '$CC')" >&2
    exit 1
fi
ok

cat > "$TMPDIR/cc_test.c" <<'EOF'
int main(void) { return 0; }
EOF
info "whether $CC works"
if ! "$CC" -o "$TMPDIR/cc_test" "$TMPDIR/cc_test.c" 2>>config.log; then
    no
    echo "configure: error: $CC cannot compile a trivial program, see config.log" >&2
    exit 1
fi
ok

cat > "$TMPDIR/xm_test.c" <<'EOF'
#include <Xm/Xm.h>
#include <Xm/PushB.h>
int main(void) {
    Widget shell = XtVaAppInitialize(0, "Test", 0, 0, 0, 0, 0, NULL);
    (void)shell;
    return 0;
}
EOF

MOTIF_CFLAGS=""
MOTIF_LIBS="-lXm -lXt -lX11"
FOUND=""

if [ "$OS" = "Darwin" ]; then
    # macOS has no system Motif/X11 dev files; we rely on Homebrew for the
    # client libraries (Motif itself, plus its Xt/Xp/X11 dependencies) and
    # on XQuartz only to provide the running X server at runtime.
    if ! command -v brew >/dev/null 2>&1; then
        echo "configure: error: Homebrew not found (required for Motif/X11 on macOS)." >&2
        echo "configure: install it from https://brew.sh, then run:" >&2
        echo "configure:   brew install openmotif json-c libxpm" >&2
        exit 1
    fi
    BREW_PREFIX=$(brew --prefix)
    MOTIF_PREFIX=$(brew --prefix openmotif 2>/dev/null || true)
    XT_PREFIX=$(brew --prefix libxt 2>/dev/null || true)
    XP_PREFIX=$(brew --prefix libxp 2>/dev/null || true)
    X11_PREFIX=$(brew --prefix libx11 2>/dev/null || true)
    XPM_PREFIX=$(brew --prefix libxpm 2>/dev/null || true)

    if [ -z "$MOTIF_PREFIX" ] || [ -z "$XT_PREFIX" ] || [ -z "$XP_PREFIX" ] || [ -z "$X11_PREFIX" ]; then
        echo "configure: error: required Homebrew packages not found." >&2
        echo "configure: install with: brew install openmotif json-c libxpm" >&2
        exit 1
    fi

    MAC_MOTIF_CFLAGS="-I$BREW_PREFIX/include -I$MOTIF_PREFIX/include -I$XT_PREFIX/include -I$XP_PREFIX/include -I$X11_PREFIX/include"
    MAC_MOTIF_LIBDIRS="-L$MOTIF_PREFIX/lib -L$XT_PREFIX/lib -L$XP_PREFIX/lib -L$X11_PREFIX/lib"
    set -- "$MAC_MOTIF_CFLAGS"
else
    # Candidate include paths to try, in order of preference. Most distros
    # (incl. Ubuntu/Debian with libmotif-dev) resolve Xm/Xt/X11 from the
    # default search paths, so an empty candidate is tried first.
    set -- "" "-I/usr/include/X11" "-I/usr/X11R6/include"
fi

info "for Motif (Xm/Xt/X11) headers and libraries"
for cflags in "$@"; do
    if [ "$OS" = "Darwin" ]; then
        libs="$MAC_MOTIF_LIBDIRS $MOTIF_LIBS"
    else
        libs="$MOTIF_LIBS"
    fi
    if "$CC" $cflags -o "$TMPDIR/xm_test" "$TMPDIR/xm_test.c" $libs 2>>config.log; then
        MOTIF_CFLAGS="$cflags"
        MOTIF_LIBS="$libs"
        FOUND=1
        break
    fi
done

if [ -z "$FOUND" ]; then
    no
    echo "configure: error: could not compile/link against Motif." >&2
    if [ "$OS" = "Darwin" ]; then
        echo "configure: install with: brew install openmotif json-c libxpm" >&2
    else
        echo "configure: install development headers, e.g.: sudo apt install libmotif-dev" >&2
    fi
    echo "configure: see config.log for details" >&2
    exit 1
fi
ok

info "for pkg-config"
if ! command -v pkg-config >/dev/null 2>&1; then
    no
    echo "configure: error: pkg-config not found (needed for libcurl / json-c)" >&2
    exit 1
fi
ok

info "for libcurl"
if ! pkg-config --exists libcurl 2>>config.log; then
    no
    echo "configure: error: libcurl development files not found." >&2
    echo "configure: install with: sudo apt install libcurl4-openssl-dev" >&2
    exit 1
fi
ok
CURL_CFLAGS=$(pkg-config --cflags libcurl)
CURL_LIBS=$(pkg-config --libs libcurl)

info "for json-c"
if ! pkg-config --exists json-c 2>>config.log; then
    no
    echo "configure: error: json-c development files not found." >&2
    if [ "$OS" = "Darwin" ]; then
        echo "configure: install with: brew install json-c" >&2
    else
        echo "configure: install with: sudo apt install libjson-c-dev" >&2
    fi
    exit 1
fi
ok
JSONC_CFLAGS=$(pkg-config --cflags json-c)
JSONC_LIBS=$(pkg-config --libs json-c)

cat > "$TMPDIR/xpm_test.c" <<'EOF'
#include <X11/xpm.h>
int main(void) { return XpmLibraryVersion() >= 0 ? 0 : 1; }
EOF

if [ "$OS" = "Darwin" ]; then
    if [ -z "$XPM_PREFIX" ]; then
        echo "configure: error: required Homebrew package 'libxpm' not found." >&2
        echo "configure: install with: brew install libxpm" >&2
        exit 1
    fi
    XPM_CFLAGS="-I$BREW_PREFIX/include -I$XPM_PREFIX/include -I$X11_PREFIX/include"
    XPM_LIBDIRS="-L$XPM_PREFIX/lib $MAC_MOTIF_LIBDIRS"
else
    XPM_CFLAGS=""
    XPM_LIBDIRS=""
fi

info "for libXpm"
if ! "$CC" $XPM_CFLAGS -o "$TMPDIR/xpm_test" "$TMPDIR/xpm_test.c" $XPM_LIBDIRS -lXpm -lX11 2>>config.log; then
    no
    echo "configure: error: libXpm development files not found." >&2
    if [ "$OS" = "Darwin" ]; then
        echo "configure: install with: brew install libxpm" >&2
    else
        echo "configure: install with: sudo apt install libxpm-dev" >&2
    fi
    exit 1
fi
ok
MOTIF_CFLAGS="$MOTIF_CFLAGS $XPM_CFLAGS"
XPM_LIBS="$XPM_LIBDIRS -lXpm"

cat > "$TMPDIR/pthread_test.c" <<'EOF'
#include <pthread.h>
static void *noop(void *arg) { (void)arg; return NULL; }
int main(void) {
    pthread_t t;
    pthread_create(&t, NULL, noop, NULL);
    pthread_join(t, NULL);
    return 0;
}
EOF

info "for pthreads"
if ! "$CC" -o "$TMPDIR/pthread_test" "$TMPDIR/pthread_test.c" -lpthread 2>>config.log; then
    no
    echo "configure: error: pthread support not found." >&2
    exit 1
fi
ok
PTHREAD_LIBS="-lpthread"

echo "configure: CC           = $CC"
echo "configure: MOTIF_CFLAGS  = $MOTIF_CFLAGS"
echo "configure: MOTIF_LIBS    = $MOTIF_LIBS"
echo "configure: CURL_CFLAGS   = $CURL_CFLAGS"
echo "configure: CURL_LIBS     = $CURL_LIBS"
echo "configure: JSONC_CFLAGS  = $JSONC_CFLAGS"
echo "configure: JSONC_LIBS    = $JSONC_LIBS"
echo "configure: XPM_LIBS      = $XPM_LIBS"
echo "configure: PTHREAD_LIBS  = $PTHREAD_LIBS"
echo "configure: PREFIX        = $PREFIX"

sed \
    -e "s|@CC@|$CC|g" \
    -e "s|@CFLAGS@|-Wall -Wextra -g $MOTIF_CFLAGS $CURL_CFLAGS $JSONC_CFLAGS|g" \
    -e "s|@LDFLAGS@||g" \
    -e "s|@LIBS@|$MOTIF_LIBS $CURL_LIBS $JSONC_LIBS $XPM_LIBS $PTHREAD_LIBS|g" \
    -e "s|@PREFIX@|$PREFIX|g" \
    Makefile.in > Makefile

echo "configure: generated Makefile"
echo "configure: now run 'make'"
