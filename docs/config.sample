# xweather configuration
#
# Install this file as:
#   $XDG_CONFIG_HOME/xweather/config
# or, if $XDG_CONFIG_HOME isn't set:
#   $HOME/.config/xweather/config
#
# Lines starting with '#' and blank lines are ignored. Keys and values are
# separated by '='; surrounding whitespace is trimmed.

# location = <display name>[|<geocoding query>]
#
# Adds one entry to the Location menu, in the order listed here (the menu
# itself sorts them alphabetically). <display name> is shown in the UI and
# must be plain ASCII. <geocoding query> is sent to the Open-Meteo geocoding
# API to resolve coordinates; if omitted, <display name> is used for both.
# Give a separate <geocoding query> when the place name needs accents or
# other characters the UI labels can't render, e.g. "Candarli|Çandarlı".


location = Aachen
location = Apricale
location = Flensburg
location = Candarli|Çandarlı
